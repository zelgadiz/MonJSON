import time
import subprocess
import socket
import platform
import configparser
import os
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import HTMLResponse
import psutil

app = FastAPI(title="PhotoStorage Metrics API - Configurable PoC Enterprise")

# Permitir que cualquier HTML local consuma este JSON
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], # Permite accesos de cualquier origen
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Ruta del archivo de configuración externo
CONFIG_FILE = "monjson.conf"

cache_datos = {}
ultima_actualizacion = 0

def cargar_configuracion():
    """Lee y procesa de forma dinámica el archivo monjson.conf"""
    config = configparser.ConfigParser()
    if not os.path.exists(CONFIG_FILE):
        # Valores de contingencia por si el archivo .conf se borra o no se encuentra
        return {
            "refresco": 30, "usuarios_ocultos": ['root', 'mngsrv'],
            "procesos": ['apache2', 'nginx', 'sshd', 'python3'],
            "secciones": {}, "subsecciones": {}
        }
    
    config.read(CONFIG_FILE)
    
    # 1. Carga de parámetros globales
    refresco = config.getint('GLOBAL', 'TIEMPO_REFRESCO_SEGUNDOS', fallback=30)
    u_ocultos = [u.strip() for u in config.get('GLOBAL', 'USUARIOS_OCULTOS', fallback='root,mngsrv').split(',')]
    p_monitoreados = [p.strip() for p in config.get('GLOBAL', 'PROCESOS_MONITOREADOS', fallback='').split(',')]
    
    # 2. Carga de banderas de visibilidad (YES/NO) de secciones
    secciones = {opcion: config.getboolean('VISIBILIDAD_SECCIONES', opcion, fallback=True) for opcion in config.options('VISIBILIDAD_SECCIONES')}
    subsecciones = {opcion: config.getboolean('VISIBILIDAD_SUBSECCIONES', opcion, fallback=True) for opcion in config.options('VISIBILIDAD_SUBSECCIONES')}
    
    return {
        "refresco": refresco,
        "usuarios_ocultos": u_ocultos,
        "procesos": p_monitoreados,
        "secciones": secciones,
        "subsecciones": subsecciones
    }

def obtener_detales_servidor():
    """Obtiene datos de identidad, red y tiempo de actividad del sistema operativo"""
    hostname = socket.gethostname()
    try: fqdn = socket.getfqdn()
    except Exception: fqdn = hostname
    try: os_version = subprocess.check_output(['lsb_release', '-ds'], text=True).strip()
    except Exception: os_version = f"{platform.system()} {platform.release()}"

    uptime_segundos = time.time() - psutil.boot_time()
    dias, horas, minutos = int(uptime_segundos // 86400), int((uptime_segundos % 86400) // 3600), int((uptime_segundos % 3600) // 60)

    return {
        "timestamp_utc": time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime()),
        "hostname": hostname, "fqdn": fqdn, "os_distribution": os_version,
        "kernel_version": platform.release(), "architecture": platform.machine(),
        "python_version": platform.python_version(), "uptime": f"{dias}d {horas}h {minutos}m",
        "boot_time": time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(psutil.boot_time()))
    }

def obtener_intentos_fallidos():
    """Lee el log de autenticación de Ubuntu para contar accesos denegados"""
    try:
        cmd = "grep -c 'Failed' /var/log/auth.log 2>/dev/null || echo '0'"
        return int(subprocess.check_output(cmd, shell=True, text=True).strip())
    except Exception: return 0

def obtener_usuarios_linux(usuarios_ocultos):
    """Obtiene de forma segura los usuarios en línea filtrando las cuentas ocultas"""
    usuarios_conectados = []
    try:
        resultado = subprocess.check_output(['who'], text=True)
        for linea in resultado.splitlines():
            partes = linea.split()
            if len(partes) >= 2:
                usuario = partes[0]
                if usuario in usuarios_ocultos: continue
                terminal = partes[1]
                host_origen = "local"
                for p in partes[2:]:
                    if '(' in p and ')' in p:
                        host_origen = p.replace('(', '').replace(')', '')
                        break
                usuarios_conectados.append({"usuario": usuario, "terminal": terminal, "host_origen": host_origen, "tiempo_activo": "Activo"})
    except Exception: pass
    return usuarios_conectados

def obtener_metricas_sistema(cfg):
    """Calcula y unifica el hardware bajo demanda según los parámetros permitidos"""
    disco = psutil.disk_usage('/')
    ram = psutil.virtual_memory()
    swap = psutil.swap_memory()
    
    # Lecturas iniciales de Red e I/O de disco
    net_io_1, disk_io_1 = psutil.net_io_counters(), psutil.disk_io_counters()
    time.sleep(1) # Pausa obligatoria de 1 segundo para medir deltas de velocidad
    # Lecturas finales
    net_io_2, disk_io_2 = psutil.net_io_counters(), psutil.disk_io_counters()
    
    kb_recibidos_sec = round((net_io_2.bytes_recv - net_io_1.bytes_recv) / 1024, 2)
    kb_enviados_sec = round((net_io_2.bytes_sent - net_io_1.bytes_sent) / 1024, 2)
    kb_leidos_sec = round((disk_io_2.read_bytes - disk_io_1.read_bytes) / 1024, 2)
    kb_escritos_sec = round((disk_io_2.write_bytes - disk_io_1.write_bytes) / 1024, 2)
    
    try:
        conexiones = psutil.net_connections()
        con_establecidas = len([c for c in conexiones if c.status == 'ESTABLISHED'])
        con_escucha = len([c for c in conexiones if c.status == 'LISTEN'])
    except Exception: con_establecidas, con_escucha = 0, 0

    # Construcción dinámica del JSON basado en lo dictado por monjson.conf
    json_salida = {}
    visibles = cfg["secciones"]
    sub_visibles = cfg["subsecciones"]

    if visibles.get("server_info", True):
        json_salida["server_info"] = obtener_detales_servidor()
        
    if visibles.get("storage", True):
        json_salida["storage"] = {
            "total_gb": round(disco.total / (1024**3), 2), "used_gb": round(disco.used / (1024**3), 2),
            "available_gb": round(disco.free / (1024**3), 2), "percentage_used": disco.percent,
            "performance": {"read_speed_kb_sec": kb_leidos_sec, "write_speed_kb_sec": kb_escritos_sec}
        }
        
    if visibles.get("cpu", True):
        json_salida["cpu"] = {"usage_percentage": psutil.cpu_percent(interval=None), "load_average": psutil.getloadavg()}
        
    if visibles.get("ram", True):
        json_salida["ram"] = {"total_mb": round(ram.total / (1024**2), 2), "used_mb": round(ram.used / (1024**2), 2), "available_mb": round(ram.available / (1024**2), 2), "percentage_used": ram.percent}
        
    if visibles.get("swap", True):
        json_salida["swap"] = {"total_mb": round(swap.total / (1024**2), 2), "used_mb": round(swap.used / (1024**2), 2), "free_mb": round(swap.free / (1024**2), 2), "percentage_used": swap.percent}
        
    if visibles.get("network", True):
        json_salida["network"] = {
            "bytes_received_total": net_io_2.bytes_recv, "bytes_sent_total": net_io_2.bytes_sent,
            "speed_download_kb_sec": kb_recibidos_sec, "speed_upload_kb_sec": kb_enviados_sec,
            "active_connections": {"established": con_establecidas, "listening": con_escucha}
        }
        
    if visibles.get("security_metrics", True):
        json_salida["security_metrics"] = {"failed_login_attempts_total": obtener_intentos_fallidos()}
        
    if visibles.get("users_online", True):
        usuarios_activos = obtener_usuarios_linux(cfg["usuarios_ocultos"])
        json_salida["users_online"] = {"total_sessions": len(usuarios_activos), "active_users": usuarios_activos}
        
    if visibles.get("processes", True):
        procesos_especificos, todos_los_procesos = [], []
        for proc in psutil.process_iter(['pid', 'name', 'cpu_percent', 'memory_info']):
            try:
                p_info = {
                    "pid": proc.info['pid'], "name": proc.info['name'], "cpu_percentage": proc.info['cpu_percent'] or 0.0,
                    "ram_mb": round(proc.info['memory_info'].rss / (1024 * 1024), 2) if proc.info['memory_info'] else 0.0
                }
                todos_los_procesos.append(p_info)
                if p_info['name'] in cfg["procesos"]: procesos_especificos.append(p_info)
            except (psutil.NoSuchProcess, psutil.AccessDenied): pass

        json_salida["processes"] = {}
        if sub_visibles.get("monitored_services", True):
            json_salida["processes"]["monitored_services"] = procesos_especificos
        if sub_visibles.get("top_3_consumers", True):
            json_salida["processes"]["top_3_consumers"] = sorted(todos_los_procesos, key=lambda x: x['cpu_percentage'], reverse=True)[:3]

    return json_salida

@app.get("/v1/status")
def obtener_estado():
    global cache_datos, ultima_actualizacion
    tiempo_actual = time.time()
    
    cfg = cargar_configuracion()
    refresco_limite = cfg["refresco"]
    
    if not cache_datos or (tiempo_actual - ultima_actualizacion) > refresco_limite:
        cache_datos = obtener_metricas_sistema(cfg)
        ultima_actualizacion = tiempo_actual
        cache_datos["origen_dato"] = "Calculado en Tiempo Real (Caché actualizada)"
    else:
        cache_datos["origen_dato"] = f"Entregado desde Caché (Próximo refresco en {round(refresco_limite - (tiempo_actual - ultima_actualizacion))}s)"
        
    return cache_datos

